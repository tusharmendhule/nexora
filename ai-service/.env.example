# ── Server ──────────────────────────────────────────────
AI_SERVICE_PORT=8000
LOG_LEVEL=info

# ── Google Gemini API (fact-checking + content review) ──
# Get a free key at https://aistudio.google.com/apikey
# When set, /v1/analyze enriches posts with real fact-check evidence and
# refines the six content checks; without it the heuristic fallback is used.
GEMINI_API_KEY=
